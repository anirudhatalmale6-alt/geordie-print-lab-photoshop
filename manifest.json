{
	"manifestVersion": 5,
	"id": "uk.co.geordieprintco.printlab",
	"name": "Geordie Print Lab",
	"version": "1.0.0",
	"main": "index.html",
	"host": [
		{
			"app": "PS",
			"minVersion": "24.0.0"
		}
	],
	"entrypoints": [
		{
			"type": "panel",
			"id": "printlab.panel",
			"label": {
				"default": "Geordie Print Lab"
			},
			"minimumSize": {
				"width": 240,
				"height": 320
			},
			"maximumSize": {
				"width": 900,
				"height": 2400
			},
			"preferredDockedSize": {
				"width": 300,
				"height": 640
			},
			"preferredFloatingSize": {
				"width": 340,
				"height": 720
			},
			"icons": [
				{
					"width": 23,
					"height": 23,
					"path": "icons/panel-light.png",
					"scale": [1, 2],
					"theme": ["lightest", "light"]
				},
				{
					"width": 23,
					"height": 23,
					"path": "icons/panel-dark.png",
					"scale": [1, 2],
					"theme": ["dark", "darkest"]
				}
			]
		}
	],
	"requiredPermissions": {
		"network": {
			"domains": [
				"https://geordieprintco.co.uk"
			]
		},
		"localFileSystem": "request"
	},
	"icons": [
		{
			"width": 48,
			"height": 48,
			"path": "icons/plugin.png",
			"scale": [1, 2],
			"theme": ["light", "dark"],
			"species": ["pluginList"]
		}
	]
}
